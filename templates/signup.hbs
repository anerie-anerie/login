<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign Up - Plantastic</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <div class="auth-page">
        <div class="auth-wrapper">
        <div style="font-size: 3rem; margin-bottom: 10px;"></div>
        <h1>Join Plantastic</h1>
        <p>Start organizing your courses & deadlines with ease.</p>

        {{#if error}}
        <p class="form-error">{{error}}</p>
        {{/if}}
        
        <form action="/signup" method="post" class="auth-form">
            <input type="text" name="name" placeholder="Choose a Username" required autocomplete="off">
            <input type="password" name="password" placeholder="Create a Password" required>
            <button type="submit" class="btn btn-primary">Create Account </button>
        </form>

        <p style="margin-top: 20px; font-size: 0.88rem;">
            Already have an account? <a href="/login" style="color: var(--sage-dark); font-weight: 600;">Log in</a>
        </p>
    </div>

</body>
</html>