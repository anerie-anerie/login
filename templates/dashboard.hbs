<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Plantastic - Dashboard</title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>

    <div class="banner-cover"></div>
    <header class="navbar">
        <div class="brand-header">
            <div class="brand-title">
                <h2>Welcome to Plantastic</h2>
                <p>Happy studying, {{naming}}!</p>
            </div>
        </div>
        <button onclick="logout()" class="btn btn-logout">Logout 🚪</button>
    </header>

    <!-- Navigation Tabs -->
    <div class="tabs-container">
        <div class="tabs">
            <button class="tab-btn active" onclick="openTab(event, 'schedule-tab')">📅 Weekly Schedule</button>
            <button class="tab-btn" onclick="openTab(event, 'assignments-tab')">📚 Assignments</button>
            <button class="tab-btn" onclick="openTab(event, 'courses-tab')">🌱 Courses</button>
        </div>
    </div>

    <!-- Main Content Area -->
    <main class="content-container">

        <!-- TAB 1: WEEKLY SCHEDULE -->
        <div id="schedule-tab" class="tab-content active">
            <div class="weekly-grid">
                
                <!-- Monday -->
                <div class="day-card">
                    <h4>Monday</h4>
                    <div class="task-section">
                        <h5>Deadlines</h5>
                        <div id="Monday-deadlines"></div>
                        <div class="data-form inline-form">
                            <input type="text" id="Monday-deadline-input" placeholder="Add deadline...">
                            <button type="button" onclick="addManualTask('Monday', 'deadlines')" class="btn btn-primary">+</button>
                        </div>
                    </div>
                    <div class="progress-container">
                        <div class="progress-label">Completion Progress</div>
                        <div class="progress-bar-bg">
                            <div id="Monday-progress" class="progress-fill"></div>
                        </div>
                    </div>
                    <div class="task-section">
                        <h5>Homework</h5>
                        <div id="Monday-homework"></div>
                        <div class="data-form inline-form">
                            <input type="text" id="Monday-homework-input" placeholder="Add task...">
                            <button type="button" onclick="addManualTask('Monday', 'homework')" class="btn btn-primary">+</button>
                        </div>
                    </div>
                </div>

                <!-- Tuesday -->
                <div class="day-card">
                    <h4>Tuesday</h4>
                    <div class="task-section">
                        <h5>Deadlines</h5>
                        <div id="Tuesday-deadlines"></div>
                        <div class="data-form inline-form">
                            <input type="text" id="Tuesday-deadline-input" placeholder="Add deadline...">
                            <button type="button" onclick="addManualTask('Tuesday', 'deadlines')" class="btn btn-primary">+</button>
                        </div>
                    </div>
                    <div class="progress-container">
                        <div class="progress-label">Completion Progress</div>
                        <div class="progress-bar-bg">
                            <div id="Tuesday-progress" class="progress-fill"></div>
                        </div>
                    </div>
                    <div class="task-section">
                        <h5>Homework</h5>
                        <div id="Tuesday-homework"></div>
                        <div class="data-form inline-form">
                            <input type="text" id="Tuesday-homework-input" placeholder="Add task...">
                            <button type="button" onclick="addManualTask('Tuesday', 'homework')" class="btn btn-primary">+</button>
                        </div>
                    </div>
                </div>

                <!-- Wednesday -->
                <div class="day-card">
                    <h4>Wednesday</h4>
                    <div class="task-section">
                        <h5>Deadlines</h5>
                        <div id="Wednesday-deadlines"></div>
                        <div class="data-form inline-form">
                            <input type="text" id="Wednesday-deadline-input" placeholder="Add deadline...">
                            <button type="button" onclick="addManualTask('Wednesday', 'deadlines')" class="btn btn-primary">+</button>
                        </div>
                    </div>
                    <div class="progress-container">
                        <div class="progress-label">Completion Progress</div>
                        <div class="progress-bar-bg">
                            <div id="Wednesday-progress" class="progress-fill"></div>
                        </div>
                    </div>
                    <div class="task-section">
                        <h5>Homework</h5>
                        <div id="Wednesday-homework"></div>
                        <div class="data-form inline-form">
                            <input type="text" id="Wednesday-homework-input" placeholder="Add task...">
                            <button type="button" onclick="addManualTask('Wednesday', 'homework')" class="btn btn-primary">+</button>
                        </div>
                    </div>
                </div>

                <!-- Thursday -->
                <div class="day-card">
                    <h4>Thursday</h4>
                    <div class="task-section">
                        <h5>Deadlines</h5>
                        <div id="Thursday-deadlines"></div>
                        <div class="data-form inline-form">
                            <input type="text" id="Thursday-deadline-input" placeholder="Add deadline...">
                            <button type="button" onclick="addManualTask('Thursday', 'deadlines')" class="btn btn-primary">+</button>
                        </div>
                    </div>
                    <div class="progress-container">
                        <div class="progress-label">Completion Progress</div>
                        <div class="progress-bar-bg">
                            <div id="Thursday-progress" class="progress-fill"></div>
                        </div>
                    </div>
                    <div class="task-section">
                        <h5>Homework</h5>
                        <div id="Thursday-homework"></div>
                        <div class="data-form inline-form">
                            <input type="text" id="Thursday-homework-input" placeholder="Add task...">
                            <button type="button" onclick="addManualTask('Thursday', 'homework')" class="btn btn-primary">+</button>
                        </div>
                    </div>
                </div>

                <!-- Friday -->
                <div class="day-card">
                    <h4>Friday</h4>
                    <div class="task-section">
                        <h5>Deadlines</h5>
                        <div id="Friday-deadlines"></div>
                        <div class="data-form inline-form">
                            <input type="text" id="Friday-deadline-input" placeholder="Add deadline...">
                            <button type="button" onclick="addManualTask('Friday', 'deadlines')" class="btn btn-primary">+</button>
                        </div>
                    </div>
                    <div class="progress-container">
                        <div class="progress-label">Completion Progress</div>
                        <div class="progress-bar-bg">
                            <div id="Friday-progress" class="progress-fill"></div>
                        </div>
                    </div>
                    <div class="task-section">
                        <h5>Homework</h5>
                        <div id="Friday-homework"></div>
                        <div class="data-form inline-form">
                            <input type="text" id="Friday-homework-input" placeholder="Add task...">
                            <button type="button" onclick="addManualTask('Friday', 'homework')" class="btn btn-primary">+</button>
                        </div>
                    </div>
                </div>

                <!-- Saturday -->
                <div class="day-card">
                    <h4>Saturday</h4>
                    <div class="task-section">
                        <h5>Deadlines</h5>
                        <div id="Saturday-deadlines"></div>
                        <div class="data-form inline-form">
                            <input type="text" id="Saturday-deadline-input" placeholder="Add deadline...">
                            <button type="button" onclick="addManualTask('Saturday', 'deadlines')" class="btn btn-primary">+</button>
                        </div>
                    </div>
                    <div class="progress-container">
                        <div class="progress-label">Completion Progress</div>
                        <div class="progress-bar-bg">
                            <div id="Saturday-progress" class="progress-fill"></div>
                        </div>
                    </div>
                    <div class="task-section">
                        <h5>Homework</h5>
                        <div id="Saturday-homework"></div>
                        <div class="data-form inline-form">
                            <input type="text" id="Saturday-homework-input" placeholder="Add task...">
                            <button type="button" onclick="addManualTask('Saturday', 'homework')" class="btn btn-primary">+</button>
                        </div>
                    </div>
                </div>

                <!-- Sunday -->
                <div class="day-card">
                    <h4>Sunday</h4>
                    <div class="task-section">
                        <h5>Deadlines</h5>
                        <div id="Sunday-deadlines"></div>
                        <div class="data-form inline-form">
                            <input type="text" id="Sunday-deadline-input" placeholder="Add deadline...">
                            <button type="button" onclick="addManualTask('Sunday', 'deadlines')" class="btn btn-primary">+</button>
                        </div>
                    </div>
                    <div class="progress-container">
                        <div class="progress-label">Completion Progress</div>
                        <div class="progress-bar-bg">
                            <div id="Sunday-progress" class="progress-fill"></div>
                        </div>
                    </div>
                    <div class="task-section">
                        <h5>Homework</h5>
                        <div id="Sunday-homework"></div>
                        <div class="data-form inline-form">
                            <input type="text" id="Sunday-homework-input" placeholder="Add task...">
                            <button type="button" onclick="addManualTask('Sunday', 'homework')" class="btn btn-primary">+</button>
                        </div>
                    </div>
                </div>

            </div>
        </div>

        <!-- TAB 2: ASSIGNMENTS -->
        <div id="assignments-tab" class="tab-content">
            <form id="assignmentForm" class="data-form">
                <select id="assignSubject" required>
                    <option value="" disabled selected>Select Course Code</option>
                </select>
                <input type="text" id="assignName" placeholder="Assignment Name" required>
                <input type="date" id="assignDueDate" required>
                <button type="submit" class="btn btn-primary">Add Assignment</button>
            </form>

            <table class="data-table">
                <thead>
                    <tr>
                        <th>Subject</th>
                        <th>Assignment</th>
                        <th>Due Date</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="assignmentTableBody">
                    <!-- Dynamic Rows -->
                </tbody>
            </table>
        </div>

        <!-- TAB 3: COURSES -->
        <div id="courses-tab" class="tab-content">
            <form id="courseForm" class="data-form">
                <input type="text" id="courseCode" placeholder="Code (e.g., ECE-105)" required>
                <input type="text" id="courseName" placeholder="Course Name" required>
                <input type="text" id="courseDesc" placeholder="Description">
                <input type="text" id="courseTechnique" placeholder="Study Technique">
                
                <div class="color-picker-group">
                    <div class="color-palette" id="colorPalette">
                        <button type="button" class="swatch active" data-color="#ffa0a0" style="background-color: #ffa0a0;"></button>
                        <button type="button" class="swatch" data-color="#ffc9a0" style="background-color: #ffc9a0;"></button>
                        <button type="button" class="swatch" data-color="#ffefa0" style="background-color: #ffefa0;"></button>
                        <button type="button" class="swatch" data-color="#d2ffa0" style="background-color: #d2ffa0;"></button>
                        <button type="button" class="swatch" data-color="#a0ffff" style="background-color: #a0ffff;"></button>
                        <button type="button" class="swatch" data-color="#c2bafc" style="background-color: #c2bafc;"></button>
                        
                        <!-- Custom Emoji Color Picker -->
                        <div class="custom-emoji-picker" id="customPickerWrapper" title="Custom Color">
                            🎨
                            <input type="color" id="customColorPicker" value="#a3b18a">
                        </div>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary">Add Course</button>
            </form>

            <table class="data-table">
                <thead>
                    <tr>
                        <th>Color</th>
                        <th>Code</th>
                        <th>Name</th>
                        <th>Description</th>
                        <th>Study Technique</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="courseTableBody">
                    <!-- Dynamic Rows -->
                </tbody>
            </table>
        </div>

    </main>

    <script>
        window.currentUser = "{{naming}}";
    </script>
    <script src="/dashboard.js"></script>
</body>
</html>